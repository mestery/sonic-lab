# Stage 1: Build the eBPF patch panel object
FROM ubuntu:22.04 AS bpf-builder
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        clang \
        libbpf-dev \
        linux-libc-dev \
        libelf-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY webmesh/bpf/patch_panel.c .
# Combine symlink fix + compile in one layer to avoid BuildKit cache issues;
# -I /usr/include ensures the BPF target searches system headers explicitly.
RUN rm -rf /usr/include/asm && \
    ln -s asm-generic /usr/include/asm && \
    clang -O2 -target bpf -I /usr/include -c patch_panel.c -o patch_panel.o

# Stage 2: Build the Go binary
FROM golang:1.25-bookworm AS go-builder
WORKDIR /app
COPY webmesh/go.mod webmesh/go.sum ./
RUN go mod download
COPY webmesh/ .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /webmesh ./cmd/webmesh

# Stage 3: Minimal runtime image
FROM debian:bookworm
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        docker.io \
        iproute2 \
        util-linux \
        ethtool \
        curl \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --from=go-builder /webmesh /usr/local/bin/webmesh
COPY --from=bpf-builder /app/patch_panel.o /etc/webmesh/patch_panel.o
ENTRYPOINT ["/usr/local/bin/webmesh"]